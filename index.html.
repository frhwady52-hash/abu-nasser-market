
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>أبو ناصر ماركت</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f1f5f9;
      color: #172033;
    }
    header {
      background: #14532d;
      color: white;
      padding: 24px 16px;
      text-align: center;
    }
    header h1 { margin: 0 0 8px; }
    main { padding: 16px; max-width: 700px; margin: auto; }
    .card {
      background: white;
      padding: 18px;
      margin-bottom: 14px;
      border-radius: 14px;
      box-shadow: 0 2px 8px #0000000c;
    }
    .total { font-size: 28px; color: #15803d; font-weight: bold; }
    input, button {
      width: 100%;
      padding: 13px;
      margin-top: 10px;
      border-radius: 9px;
      font-size: 16px;
    }
    input { border: 1px solid #cbd5e1; }
    button {
      border: none;
      background: #15803d;
      color: white;
      font-weight: bold;
      cursor: pointer;
    }
    .customer {
      padding: 12px 0;
      border-bottom: 1px solid #e2e8f0;
    }
    .small { color: #64748b; font-size: 13px; }
    .delete { background: #b91c1c; }
  </style>
</head>
<body>
  <header>
    <h1>🛒 أبو ناصر ماركت</h1>
    <div>نظام إدارة حسابات المحل</div>
  </header>

  <main>
    <section class="card">
      <h3>إجمالي الديون المتبقية</h3>
      <div class="total" id="total">0.00 ₪</div>
      <p class="small">البيانات في هذه النسخة محفوظة على هذا الجهاز فقط.</p>
    </section>

    <section class="card">
      <h3>➕ إضافة زبون</h3>
      <input id="name" placeholder="اسم الزبون">
      <input id="phone" placeholder="رقم الهاتف (اختياري)">
      <input id="debt" type="number" min="0" step="0.01" placeholder="الدين الأول بالشيكل">
      <button onclick="addCustomer()">حفظ الزبون</button>
    </section>

    <section class="card">
      <h3>👥 قائمة الزبائن</h3>
      <div id="customers">لا يوجد زبائن حتى الآن.</div>
    </section>
  </main>

  <script>
    let customers = [];
    try {
      customers = JSON.parse(localStorage.getItem("abuNasserCustomers") || "[]");
      if (!Array.isArray(customers)) customers = [];
    } catch (e) {
      customers = [];
    }

    function save() {
      try {
        localStorage.setItem("abuNasserCustomers", JSON.stringify(customers));
      } catch (e) {
        alert("تعذر حفظ البيانات على هذا الجهاز.");
      }
      render();
    }

    function addCustomer() {
      const name = document.getElementById("name").value.trim();
      const phone = document.getElementById("phone").value.trim();
      const debtText = document.getElementById("debt").value;
      const debt = Number(debtText || 0);

      if (!name) return alert("اكتب اسم الزبون أولاً.");
      if (!Number.isFinite(debt) || debt < 0)
        return alert("أدخل ديناً صحيحاً.");

      customers.push({
        id: Date.now(),
        name, phone, debt
      });

      document.getElementById("name").value = "";
      document.getElementById("phone").value = "";
      document.getElementById("debt").value = "";
      save();
    }

    function payment(id) {
      const c = customers.find(x => x.id === id);
      if (!c) return;

      const amount = Number(prompt("كم دفع الزبون بالشيكل؟"));
      if (!Number.isFinite(amount) || amount <= 0)
        return alert("أدخل مبلغاً صحيحاً.");
      if (amount > c.debt)
        return alert("المبلغ أكبر من الدين المتبقي.");

      c.debt = Math.round((c.debt - amount) * 100) / 100;
      save();
    }

    function removeCustomer(id) {
      if (!confirm("هل تريد حذف هذا الزبون؟")) return;
      customers = customers.filter(c => c.id !== id);
      save();
    }

    function render() {
      const total = customers.reduce((s, c) => s + c.debt, 0);
      document.getElementById("total").textContent =
        total.toFixed(2) + " ₪";

      const list = document.getElementById("customers");
      list.replaceChildren();

      if (!customers.length) {
        list.textContent = "لا يوجد زبائن حتى الآن.";
        return;
      }

      customers.forEach(c => {
        const item = document.createElement("div");
        item.className = "customer";

        const title = document.createElement("strong");
        title.textContent = c.name;
        item.appendChild(title);

        const details = document.createElement("p");
        details.textContent =
          (c.phone ? "الهاتف: " + c.phone + " | " : "") +
          "الدين المتبقي: " + c.debt.toFixed(2) + " ₪";
        item.appendChild(details);

        const pay = document.createElement("button");
        pay.textContent = "تسجيل دفعة";
        pay.onclick = () => payment(c.id);
        item.appendChild(pay);

        const del = document.createElement("button");
        del.textContent = "حذف الزبون";
        del.className = "delete";
        del.onclick = () => removeCustomer(c.id);
        item.appendChild(del);

        list.appendChild(item);
      });
    }

    render();
  </script>
</body>
</html>
